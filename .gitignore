# Dependencies and build output live under site/ and are ignored by site/.gitignore.
# This file covers the working directory around it.

# The six GLBs at the top level are byte-identical copies of site/public/models/.
# The app loads them from public/; keeping a second copy here would double the repo
# for nothing. Delete these locally if you want — nothing reads them.
/camera_rig_web.glb
/futuristic_control_ring_web.glb
/futuristic_machinery_web.glb
/green_technical_device_web.glb
/sci-fi_control_table_web.glb
/sci-fi_prop_web.glb

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
